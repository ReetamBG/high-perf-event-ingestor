# ============================================================
# Stress-test configuration. Copy to .env and source it before
# running k6, or export the variables directly in your shell.
# NEVER commit a real JWT.
# ============================================================

# --- Target (backend-agnostic: any HTTP endpoint) ---
TARGET_URL=http://localhost:8080/events/ingest

# --- Auth: JWT is injected into every request's Authorization header ---
# Generate with: ./scripts/generate-jwt.sh <jwt-secret> [ttl-seconds]
JWT_TOKEN=

# --- Sustained test ---
RATE=1000
DURATION=60s

# --- Progressive test: comma-separated "rate:duration" stages ---
STAGES=1000:30s,5000:30s,10000:30s,15000:30s,20000:30s

# --- Burst test ---
BASELINE_RATE=1000
BASELINE_DURATION=30s
BURST_RATE=20000
BURST_DURATION=10s
RECOVERY_DURATION=60s

# --- Load-generator tuning ---
MAX_VUS=500

# --- Stage instability flagging thresholds ---
ERROR_RATE_THRESHOLD=1        # percent; stage flagged if error rate exceeds this
P99_SPIKE_FACTOR=2            # stage flagged if p99 > factor * first-stage p99 (ms)
THROUGHPUT_TOLERANCE=0.95     # stage flagged if achieved throughput < rate * this

# --- Container resource sampler (scripts/collect-container-metrics.sh) ---
CONTAINER_NAME=ingestion-service
SAMPLE_INTERVAL=1

# --- Storage verification (scripts/verify-storage.sh) ---
S3_ENDPOINT=http://localhost:8333
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=secret
S3_BUCKET=my-bucket
